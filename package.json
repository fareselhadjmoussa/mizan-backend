{
  "name": "pos-backend",
  "version": "2.0.0",
"scripts": {
  "dev": "ts-node-dev --respawn src/index.ts",

  "clean": "rimraf dist",

  "generate": "prisma generate",

  "build": "npm run clean && npm run generate && tsc",

  "start": "node dist/index.js",

  "postinstall": "npm run generate",

  "seed": "ts-node prisma/seed.ts",

  "prisma:migrate": "prisma migrate deploy"
}
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.4",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "prisma": "^5.22.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.19.43",
    "@types/uuid": "^9.0.8",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
